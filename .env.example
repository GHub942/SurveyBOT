# BOT TOKEN (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=paste_your_token_here

# BOT ID (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=paste_your_client_id_here

# (optional) ID of a server to deploy commands instantly in dev
# Leave empty for global deployment (may take up to 1h to propagate)
# GUILD_ID=paste_your_guild_id_here

# (optional) Log level for direct `npm start`; launch scripts ask each time
# LOG_LEVEL=info